# Handle line endings automatically for files detected as text
# and leave all other files alone.
* text=auto

# Standard C# and .NET overrides
*.cs text eol=crlf diff=csharp
# Generated protocol sources use the same normalized line ending; encoding
# (UTF-8 without BOM) is enforced by .editorconfig and Verify-SourceEncoding.ps1.
*.g.cs text eol=crlf diff=csharp
*.csproj text
*.sln text eol=crlf
*.slnx text
*.props text
*.targets text
*.editorconfig text
*.gitignore text
*.md text eol=crlf
