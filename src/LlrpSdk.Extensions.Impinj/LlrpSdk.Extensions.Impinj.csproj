<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>LLRPCSharp Impinj Extension Plugin</Title>
    <Description>Impinj RFID reader extension plugin for LlrpSdk, providing UseImpinj(), custom capabilities, Serialized TID, RF Phase, and Impinj extensions.</Description>
    <PackageTags>rfid;llrp;impinj;speedway;revolution;r420;r700;sdk;plugin</PackageTags>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectOutputs</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LlrpNet\LlrpNet.Protocol.Impinj\LlrpNet.Protocol.Impinj.csproj" PrivateAssets="all" IncludeAssets="compile;runtime" />
    <ProjectReference Include="..\LlrpSdk\LlrpSdk.csproj" />
    <ProjectReference Include="..\LlrpSdk.Extensions.Abstractions\LlrpSdk.Extensions.Abstractions.csproj" PrivateAssets="all" IncludeAssets="compile;runtime" />
  </ItemGroup>

  <Target Name="IncludeReferencedProjectOutputs">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)LlrpNet.Protocol.Impinj.dll" />
      <BuildOutputInPackage Include="$(OutputPath)LlrpNet.Protocol.Impinj.pdb" Condition="Exists('$(OutputPath)LlrpNet.Protocol.Impinj.pdb')" />
    </ItemGroup>
  </Target>
</Project>
