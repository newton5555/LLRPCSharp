<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>LLRPCSharp Core SDK</Title>
    <Description>Modern .NET LLRP SDK for RFID readers, supporting LLRP 1.0.1, auto-negotiation, managed inventory, tag access, and reader configuration.</Description>
    <PackageTags>rfid;llrp;sdk;csharp;dotnet;rfid-reader</PackageTags>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectOutputs</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LlrpNet\LlrpNet.Core\LlrpNet.Core.csproj" PrivateAssets="all" IncludeAssets="compile;runtime" />
    <ProjectReference Include="..\LlrpNet\LlrpNet.Protocol\LlrpNet.Protocol.csproj" PrivateAssets="all" IncludeAssets="compile;runtime" />
    <ProjectReference Include="..\LlrpSdk.Extensions.Abstractions\LlrpSdk.Extensions.Abstractions.csproj" PrivateAssets="all" IncludeAssets="compile;runtime" />
  </ItemGroup>

  <Target Name="IncludeReferencedProjectOutputs">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)LlrpNet.Core.dll" />
      <BuildOutputInPackage Include="$(OutputPath)LlrpNet.Core.pdb" Condition="Exists('$(OutputPath)LlrpNet.Core.pdb')" />
      <BuildOutputInPackage Include="$(OutputPath)LlrpNet.Protocol.dll" />
      <BuildOutputInPackage Include="$(OutputPath)LlrpNet.Protocol.pdb" Condition="Exists('$(OutputPath)LlrpNet.Protocol.pdb')" />
      <BuildOutputInPackage Include="$(OutputPath)LlrpSdk.Extensions.Abstractions.dll" />
      <BuildOutputInPackage Include="$(OutputPath)LlrpSdk.Extensions.Abstractions.pdb" Condition="Exists('$(OutputPath)LlrpSdk.Extensions.Abstractions.pdb')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LlrpSdk.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LlrpSdk.Extensions.Impinj.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LlrpSdk.Extensions.Zebra.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
