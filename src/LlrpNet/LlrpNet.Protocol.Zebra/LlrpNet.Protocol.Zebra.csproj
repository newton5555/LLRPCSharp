<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>LlrpNet.Protocol.Zebra</RootNamespace>
    <IsPackable>true</IsPackable>
    <Title>LLRPCSharp Zebra Protocol Extension</Title>
    <Description>Generated Zebra (Moto) LLRP 1.0.1 messages, parameters, codecs, and registry module.</Description>
    <PackageTags>llrp;zebra;moto;protocol;codec;rfid</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LlrpNet.Protocol\LlrpNet.Protocol.csproj" />
    <ProjectReference Include="..\LlrpNet.Core\LlrpNet.Core.csproj" PrivateAssets="all" IncludeAssets="compile;runtime" />
  </ItemGroup>
</Project>
