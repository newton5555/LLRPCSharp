flowchart TB
    subgraph APP["Application and client layer"]
        CLI["LlrpCli<br/>client commands"]
        CLIENT_APP["WPF / third-party client"]
        DEVICE_CLI["LlrpVirtualDevice.Cli<br/>one device / foreground"]
        SDK["LlrpSdk<br/>LlrpReader / client adapter"]
        SDK_EXT["LlrpSdk.Extensions.*<br/>client vendor projections"]
    end

    subgraph NET["LlrpNet: shared communication and protocol layer"]
        CLIENT_TCP["LlrpNet.Core<br/>client TCP transport"]
        SERVER_TCP["LlrpNet.Core<br/>accepted TCP transport / session"]
        FRAME["LlrpNet.Core<br/>frame / header / observer"]
        REGISTRY["LlrpNet.Protocol<br/>LlrpCodecRegistry"]
        WIRE["LlrpNet.Protocol.Impinj / Zebra<br/>vendor wire codecs"]
    end

    subgraph DEVICE["Generic device-side runtime"]
        HOST["LlrpDevice.Virtual.Hosting<br/>IVirtualLlrpDeviceHost"]
        SERVER["LlrpDevice.Server<br/>listener / dispatch / resources / reports"]
        CONTRACT["LlrpDevice.Abstractions<br/>ILlrpDevice"]
        VIRTUAL["LlrpDevice.Virtual<br/>VirtualLlrpDevice + deterministic RF"]
        CONFIG["Single-device JSON<br/>explicit load"]
        EXT["ILlrpDeviceProtocolModule<br/>device-side extension point"]
    end

    PLATFORM["LlrpReaderPlatform<br/>platform session substitute<br/>OUT OF SCOPE"]

    CLI --> SDK
    CLIENT_APP --> SDK
    DEVICE_CLI --> HOST
    SDK_EXT --> SDK
    SDK --> CLIENT_TCP
    CLIENT_TCP --> FRAME
    FRAME --> CLIENT_TCP

    HOST -->|"compose one"| SERVER
    HOST -->|"compose one"| VIRTUAL
    CONFIG --> DEVICE_CLI
    SERVER --> SERVER_TCP
    SERVER_TCP --> FRAME
    FRAME -->|"decode / encode"| REGISTRY
    REGISTRY -->|"typed version messages"| SERVER
    SERVER --> CONTRACT
    CONTRACT --> VIRTUAL
    SERVER --> EXT
    WIRE -.->|"register codecs"| REGISTRY
