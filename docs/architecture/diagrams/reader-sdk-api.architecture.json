  "cards": [
    {
      "dot": "cyan",
      "title": "应用入口",
      "items": [
        "LlrpReaderBuilder 将 host、端口和选项组装成托管 Reader",
        "LlrpReader 封装常用 ROSpec / AccessSpec 操作，同时保留 RoSpecs、AccessSpecs、Protocol、Registry 专家入口"
      ]
    },
    {
      "dot": "emerald",
      "title": "托管能力",
      "items": [
        "ReaderSettings 是配置模型；默认值、校验、查询和应用由 LlrpReader 编排",
        "报告链为 UnsolicitedFrames → Reader Pump → TranslateTagReports → InventorySession / TagsReported；标准 Tag Access 自动管理底层资源"
      ]
    },
    {
      "dot": "violet",
      "title": "边界与状态",
      "items": [
        "ILlrpProtocolAdapter 是内部版本边界，收敛 1.0.1、1.1、2.0 的协商、编译、反解析和事件投影",
        "DesiredState 与设备 Observed 快照分离；默认 PreserveForeign，ReplaceAll 需显式选择"
      ]
    }
  ]
